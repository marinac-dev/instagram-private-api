{
  "name": "instagram-private-api",
  "description": "Instagram private API wrapper for full access to instagram",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/dilame/instagram-private-api/issues",
    "email": "dilame.nickolson@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dilame/instagram-private-api.git"
  },
  "homepage": "https://github.com/dilame/instagram-private-api",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepare": "husky || true && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-interface": "ts-node ./tools/response-to-interface.ts",
    "generate-docs": "typedoc"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@lifeomic/attempt": "^3.0.0",
    "axios": "^1.20.0",
    "chance": "^1.0.18",
    "class-transformer": "^0.5.1",
    "debug": "^4.1.1",
    "hpagent": "^1.2.0",
    "image-size": "^2.0.2",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.20",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "snakecase-keys": "^3.1.0",
    "tough-cookie": "^5.1.2",
    "ts-custom-error": "^2.2.2",
    "ts-xor": "^1.0.6",
    "url-regex-safe": "^3.0.0"
  },
  "peerDependencies": {
    "re2": "^1.17.2"
  },
  "peerDependenciesMeta": {
    "re2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chance": "^1.1.8",
    "@types/lodash": "^4.14.123",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.19.43",
    "dotenv": "^6.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "inquirer": "^1.1.2",
    "json-ts": "^1.6.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
